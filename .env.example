# Copy to .env (never commit .env). All settings are read at startup.
# NODE_ENV is set by Next.js itself (development for `npm run dev`, production for `npm start`).
DATABASE_URL=postgres://scopeflow:CHANGE_ME@localhost:5432/scopeflow
# Long random string, e.g. output of: openssl rand -base64 48
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
# Development only: tenant used when the request host is not a verified tenant domain.
DEV_TENANT_SLUG=chayse
# true: read the visitor's address from X-Forwarded-Host. Required, because Next.js itself
# renders redirects through an internal hop that sets it. Only safe when the app listens on
# 127.0.0.1 behind the web server (Plesk/nginx) and can't be reached directly.
TRUST_PROXY=true
# console = print emails to the server log (development); smtp = send for real.
MAIL_TRANSPORT=console
MAIL_FROM=ScopeFlow <no-reply@chayse.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where uploaded logos are kept (replace with S3-compatible storage later).
STORAGE_DIR=./storage
# AI suggestions on change requests. Leave the key empty to switch the feature off entirely.
# Each workspace admin must also turn it on in Settings. Change requests text and the agreed scope
# items are sent to Anthropic when someone asks for suggestions; prices and people are not.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2026-10-21
